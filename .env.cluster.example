# MeshSat Hub — Cluster Mode Environment Variables
# Copy to .env and fill in values before running docker-compose.cluster.yml

# --- Hub Service ---
HUB_MODE=cluster
HUB_PORT=6070
HUB_LOG_LEVEL=info
HUB_LOG_FORMAT=json

# --- PostgreSQL ---
POSTGRES_USER=meshsat
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=meshsat_hub
HUB_DATABASE_URL=postgres://meshsat:CHANGE_ME_postgres_password@postgres:5432/meshsat_hub?sslmode=disable

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password
HUB_REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- NATS (MQTT adapter replaces standalone Mosquitto) ---
HUB_NATS_URL=tcp://nats:1883
HUB_MQTT_BROKER_URL=tcp://nats:1883
HUB_MQTT_CLIENT_ID=meshsat-hub

# --- Authentication ---
# Token auth (simple):
HUB_AUTH_TOKEN=
# OIDC auth (production):
# HUB_OIDC_ISSUER_URL=https://auth.example.com
# HUB_OIDC_AUDIENCE=meshsat-hub

# --- Iridium / Cloudloop ---
HUB_ROCKBLOCK_SECRET=
HUB_CLOUDLOOP_API_KEY=
HUB_CLOUDLOOP_API_URL=https://api.cloudloop.com

# --- Rate Limiting ---
HUB_RATELIMIT_DAILY_CAP=100
HUB_RATELIMIT_MONTHLY_CAP=0
HUB_RATELIMIT_BURST=10
HUB_RATELIMIT_REFILL_PER_MIN=1

# --- Tenant Isolation ---
HUB_TENANT_ENFORCE=false

# --- TLS (Caddy) ---
CADDY_DOMAIN=hub.example.com
CADDY_EMAIL=admin@example.com

# --- TAK/CoT (optional) ---
HUB_TAK_ENABLED=false
HUB_TAK_HOST=opentakserver
HUB_TAK_PORT=8087

# --- APRS-IS (optional) ---
HUB_APRSIS_ENABLED=false
HUB_APRSIS_CALLSIGN=
HUB_APRSIS_PASSCODE=

# --- WireGuard (optional) ---
HUB_WG_ENABLED=false
HUB_WG_URL=
HUB_WG_PASSWORD=
