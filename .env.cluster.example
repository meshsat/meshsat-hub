# MeshSat Hub — Cluster Mode (.env)
# Copy to .env on EACH node and fill in values.
#   cp .env.cluster.example .env
#
# This configures a multi-node deployment with MariaDB Galera, NATS, and Redis.
# See docs/deployment.md for the full cluster setup guide.

# =============================================================================
# CLUSTER IDENTITY (unique per node)
# =============================================================================

# Site name — must be unique per node (used as NATS server name + Galera node name)
SITE_NAME=meshsat-hub-node1

# This node's VPN/private IP (other nodes connect to this address)
WSREP_NODE_ADDRESS=10.0.0.1

# =============================================================================
# GALERA CLUSTER
# =============================================================================

# Comma-separated VPN IPs of ALL Galera nodes (same on every node)
# Example for 2-node cluster: gcomm://10.0.0.1,10.0.0.2
# NEVER set to bare gcomm:// — that causes independent bootstrap and split-brain.
WSREP_CLUSTER_ADDRESS=gcomm://10.0.0.1,10.0.0.2

# MariaDB credentials (same on all nodes)
MARIADB_ROOT_PASSWORD=CHANGE_ME_root_password
MARIADB_PASSWORD=CHANGE_ME_app_password

# =============================================================================
# HUB SERVICE
# =============================================================================

HUB_MODE=cluster
HUB_PORT=6070
HUB_LOG_LEVEL=info
HUB_LOG_FORMAT=json

# MQTT client ID — MUST be unique per node to avoid NATS session conflicts
HUB_MQTT_CLIENT_ID=meshsat-hub-node1

# Internal connections (these use Docker service names, same on all nodes)
HUB_NATS_URL=tcp://nats:1883
HUB_MQTT_BROKER_URL=tcp://nats:1883
HUB_REDIS_URL=redis://redis:6379/0

# Database URL (Hub connects to MariaDB via the host's private IP, not Docker service name,
# because MariaDB runs on host network for Galera replication)
HUB_DATABASE_URL=mariadb://meshsat:CHANGE_ME_app_password@host.docker.internal:3306/meshsat_hub

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Simple token auth (generate with: openssl rand -hex 32)
HUB_AUTH_TOKEN=CHANGE_ME_auth_token

# OIDC auth (production — replaces token auth):
# HUB_OIDC_ISSUER_URL=https://auth.example.com
# HUB_OIDC_AUDIENCE=meshsat-hub

# =============================================================================
# mTLS (bridge client certificate verification)
# =============================================================================

# NATS config file (use nats-mtls.conf to enable mTLS WebSocket on port 9443)
NATS_CONFIG=./nats-mtls.conf

# Path where Hub exports its bridge CA cert for NATS to read (shared Docker volume)
HUB_BRIDGE_CA_CERT_EXPORT_PATH=/nats-certs/bridge-ca.crt

# Public URL that bridges use to connect (shown during onboarding)
# Set via Hub Settings page or: curl -X PUT /api/settings/mqtt-url -d '{"mqtt_url":"wss://mqtt.example.com/mqtt"}'
# MESHSAT_MQTT_PUBLIC_URL=wss://mqtt.example.com/mqtt

# =============================================================================
# SATELLITE (optional)
# =============================================================================

HUB_ROCKBLOCK_SECRET=
HUB_CLOUDLOOP_API_KEY=
HUB_CLOUDLOOP_API_URL=https://api.cloudloop.com

# =============================================================================
# RATE LIMITING
# =============================================================================

HUB_RATELIMIT_DAILY_CAP=100
HUB_RATELIMIT_MONTHLY_CAP=0
HUB_RATELIMIT_BURST=10
HUB_RATELIMIT_REFILL_PER_MIN=1

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

HUB_TAK_ENABLED=false
HUB_APRSIS_ENABLED=false
HUB_WG_ENABLED=false

# =============================================================================
# OBSERVABILITY (optional)
# =============================================================================

# HUB_PPROF_ENABLED=false
# HUB_DB_SLOW_QUERY_MS=100
# HUB_AUDIT_RETENTION_DAYS=90
# HUB_HEALTH_PROBE_TIMEOUT=3s
# HUB_OTEL_ENDPOINT=
