# Binaries
bin/
/meshsat-hub
*.exe

# Go
vendor/
# Not Go: the console's vendored Codec2 decoder (two pinned files, see
# web/public/vendor/codec2/LICENSES.md) and its copy in the embedded dist
# are tracked on purpose (MESHSAT-1735).
!web/public/vendor/
!cmd/meshsat-hub/web/dist/vendor/

# Node
node_modules/
web/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
*.env.local

# Data
*.db
*.db-journal
*.db-wal
data/

# OWASP scan reports (generated)
test/owasp/reports/
owasp-reports/

# Python RNS compatibility tests (diagnostic tools, not CI)
test/rns_compat/

# Docker
docker-compose.override.yml

# Tor keys (sensitive)
tor-keys/

# OS
.DS_Store
Thumbs.db
meshsat-sim

# python bytecode from local script checks
__pycache__/
*.pyc

# Probe credentials. scratchpad/ scripts drive production; the one key they may
# be given is a Stripe TEST key, and it still never belongs in git.
scratchpad/.stripe-test-key
scratchpad/*.key
scratchpad/.env
.iac-dockerfiles/
