# Dockerfile.sim — MeshSat Simulator
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /meshsat-sim ./cmd/meshsat-sim/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=build /meshsat-sim /usr/local/bin/meshsat-sim
ENTRYPOINT ["meshsat-sim"]
