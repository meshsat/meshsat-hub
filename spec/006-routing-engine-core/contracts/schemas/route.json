{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "route.json",
  "title": "Route",
  "description": "Per-tenant routing rule: (source_type, filter) → destination_type.",
  "type": "object",
  "required": ["route_id", "tenant_id", "name", "source_type", "destination_type", "enabled", "created_at", "updated_at"],
  "properties": {
    "route_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_type": {
      "type": "string",
      "enum": ["mo_decoded", "position", "sos", "telemetry"]
    },
    "destination_type": {
      "type": "string",
      "enum": ["tak", "aprs_is", "webhook", "notification", "mqtt", "sms", "email"]
    },
    "filter": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "maxLength": 200
        },
        "portnum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "device_imei": {
          "type": "string",
          "pattern": "^[0-9]{15}$"
        }
      },
      "additionalProperties": false
    },
    "enabled": {
      "type": "boolean"
    },
    "created_at": {
      "type": "integer",
      "minimum": 1700000000
    },
    "updated_at": {
      "type": "integer",
      "minimum": 1700000000
    }
  },
  "additionalProperties": false
}
