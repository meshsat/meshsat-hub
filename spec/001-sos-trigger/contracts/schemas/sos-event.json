{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meshsat.net/schemas/hub/sos-event.json",
  "title": "SosEvent",
  "description": "SOS event row in the hub's database (CGC-verified at internal/sos/).",
  "type": "object",
  "required": ["id", "tenant_id", "bridge_id", "triggered_at", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "tenant_id": {"type": "string", "minLength": 1},
    "bridge_id": {"type": "string", "minLength": 1},
    "device_id": {"type": ["string", "null"]},
    "triggered_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "trigger_token": {
      "type": "string",
      "enum": ["SOS", "MAYDAY", "EMERGENCY"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "acknowledged", "resolved"]
    },
    "acknowledged_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "resolved_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
