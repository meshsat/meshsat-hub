{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fragment-event.json",
  "title": "FragmentEvent",
  "description": "Audit-log event for fragment lifecycle (error or timeout). Written via existing audit.Service.",
  "type": "object",
  "required": ["event_type", "event_at", "imei", "message_id"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["fragment.error", "fragment.timeout"]
    },
    "event_at": {
      "type": "integer",
      "minimum": 1700000000
    },
    "imei": {
      "type": "string",
      "pattern": "^[0-9]{15}$"
    },
    "message_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "fragments_received": {
      "type": "integer",
      "minimum": 0,
      "description": "Fragments arrived before the error/timeout"
    },
    "fragments_total": {
      "type": "integer",
      "minimum": 2,
      "description": "Fragments expected per the first fragment's header"
    },
    "error_detail": {
      "type": "string",
      "maxLength": 500,
      "description": "Present when event_type=fragment.error"
    }
  },
  "additionalProperties": false
}
