# MeshSat Hub — Standalone Mode (.env)
# Copy to .env and fill in your values:
#   cp .env.standalone.example .env
#
# This configures a single-node deployment with SQLite, Mosquitto, and Caddy.
# See docs/deployment.md for the full guide.

# =============================================================================
# REQUIRED
# =============================================================================

# Auth token for Hub API access (generate with: openssl rand -hex 32)
HUB_AUTH_TOKEN=

# Your domain name (Caddy will auto-provision Let's Encrypt TLS)
CADDY_DOMAIN=hub.example.com
CADDY_EMAIL=admin@example.com

# =============================================================================
# SATELLITE (optional — leave blank if not using Iridium)
# =============================================================================

# RockBLOCK webhook shared secret (from Ground Control portal)
HUB_ROCKBLOCK_SECRET=

# Cloudloop API key (for sending MT messages via Iridium)
HUB_CLOUDLOOP_API_KEY=
HUB_CLOUDLOOP_API_URL=https://api.cloudloop.com

# Default device IMEI (single-device mode, optional)
HUB_DEVICE_IMEI=

# =============================================================================
# RATE LIMITING
# =============================================================================

HUB_RATELIMIT_BURST=10
HUB_RATELIMIT_REFILL_PER_MIN=1
HUB_RATELIMIT_DAILY_CAP=100
HUB_RATELIMIT_MONTHLY_CAP=0

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# TAK/CoT server
HUB_TAK_ENABLED=false
# HUB_TAK_HOST=opentakserver
# HUB_TAK_PORT=8087

# APRS-IS IGate
HUB_APRSIS_ENABLED=false
# HUB_APRSIS_SERVER=euro.aprs2.net:14580
# HUB_APRSIS_CALLSIGN=
# HUB_APRSIS_PASSCODE=

# =============================================================================
# OBSERVABILITY (optional)
# =============================================================================

HUB_LOG_LEVEL=info
HUB_LOG_FORMAT=json
# HUB_PPROF_ENABLED=false
# HUB_DB_SLOW_QUERY_MS=100
# HUB_OTEL_ENDPOINT=
