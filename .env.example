# MeshSat Hub — Production Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# --- Required ---

# RockBLOCK webhook shared secret (from Ground Control portal)
HUB_ROCKBLOCK_SECRET=

# Cloudloop API key (for MT message sending)
HUB_CLOUDLOOP_API_KEY=

# Device IMEI (single-device mode)
HUB_DEVICE_IMEI=

# Simple auth token for API access
HUB_AUTH_TOKEN=

# --- Optional: TAK/CoT ---

HUB_TAK_ENABLED=false
HUB_TAK_HOST=opentakserver
HUB_TAK_PORT=8087
HUB_TAK_SSL=false
HUB_TAK_CALLSIGN_PREFIX=MESHSAT-HUB
HUB_TAK_COT_STALE_SECONDS=600

# --- Optional: APRS-IS ---

HUB_APRSIS_ENABLED=false
HUB_APRSIS_SERVER=euro.aprs2.net:14580
HUB_APRSIS_CALLSIGN=
HUB_APRSIS_PASSCODE=

# --- Optional: Rate limiting ---

HUB_RATELIMIT_BURST=10
HUB_RATELIMIT_REFILL_PER_MIN=1
HUB_RATELIMIT_DAILY_CAP=100
