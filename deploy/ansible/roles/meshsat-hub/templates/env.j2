# MeshSat Hub — {{ site_name }} (managed by Ansible)
SITE_NAME={{ site_name }}
MARIADB_ROOT_PASSWORD={{ mariadb_root_password }}
MARIADB_PASSWORD={{ mariadb_password }}
WSREP_CLUSTER_ADDRESS={{ galera_cluster_address }}
WSREP_NODE_ADDRESS={{ vpn_ip }}
HUB_MODE=cluster
HUB_MQTT_CLIENT_ID={{ site_name }}
HUB_DATABASE_URL={{ mariadb_password }}@tcp({{ vpn_ip }}:3306)/meshsat_hub?parseTime=true
HUB_NATS_URL=tcp://meshsat:{{ nats_mqtt_password }}@nats:1883
HUB_MQTT_BROKER_URL=tcp://meshsat:{{ nats_mqtt_password }}@nats:1883
HUB_REDIS_URL=redis://:{{ redis_password }}@redis:6379/0
HUB_AUTH_TOKEN={{ auth_token }}
HUB_JWT_SIGNING_KEY={{ jwt_signing_key }}
HUB_CLUSTER_PEERS={{ cluster_peers }}
NATS_MQTT_PASSWORD={{ nats_mqtt_password }}
NATS_LEAFNODE_TOKEN={{ nats_leafnode_token }}
REDIS_PASSWORD={{ redis_password }}
NATS_CONFIG=./nats-mtls.conf
HUB_BRIDGE_CA_CERT_EXPORT_PATH=/nats-certs/bridge-ca.crt
HUB_ROCKBLOCK_SECRET=
HUB_CLOUDLOOP_API_KEY=
HUB_RATELIMIT_BURST=10
HUB_RATELIMIT_REFILL_PER_MIN=1
HUB_RATELIMIT_DAILY_CAP=100
HUB_TAK_ENABLED=false
HUB_APRSIS_ENABLED=false
HUB_WG_ENABLED=false
HUB_HAWKBIT_ENABLED=false
