# MeshSat Hub — HAProxy SNI Passthrough
#
# This runs on a DMZ/edge node and peeks at the TLS SNI header to route traffic:
#
#   reticulum.example.com → TCP passthrough to stunnel :4243 (Reticulum HDLC)
#   mqtt.example.com      → TCP passthrough to NATS :9443 (mTLS bridge connections)
#   *                     → Default HTTPS backend (Hub nginx :8451 or other TLS service)
#
# HAProxy does NOT terminate TLS for any backend. It passes raw TCP streams:
#   - Reticulum: stunnel terminates TLS, forwards plaintext HDLC to Hub :4242
#   - MQTT: NATS handles TLS + client certificate verification directly
#   - HTTPS: nginx or other service handles its own TLS
#
# Prerequisites:
#   - DNS A records for reticulum.example.com, mqtt.example.com, hub.example.com
#   - stunnel on :4243 forwarding to Hub :4242 (see /etc/stunnel/reticulum.conf)
#   - NATS on :9443 (mTLS WebSocket)
#   - nginx on :8451 (Hub web UI, TLS)
#
# Usage:
#   1. Copy this file and replace ALL example.com references with your domain
#   2. Replace backend IPs with your actual node IPs
#   3. Deploy as container: docker run -d --network host --user root \
#        -v /srv/haproxy/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro \
#        haproxy:2.9-alpine
#   4. Or install: apt install haproxy && cp haproxy.cfg /etc/haproxy/

global
    log /dev/log local0
    maxconn 4096
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    timeout connect 10s
    timeout client  300s
    timeout server  300s

# =============================================================================
# FRONTEND: Port 443 — SNI-based routing
# =============================================================================

frontend tls_in
    bind *:443
    mode tcp

    # Peek at the TLS ClientHello to read the SNI hostname
    tcp-request inspect-delay 5s
    tcp-request content accept if { req_ssl_hello_type 1 }

    # Route by SNI hostname
    # CHANGE: Replace example.com with your domain
    use_backend meshsat_reticulum if { req_ssl_sni -i reticulum.example.com }
    use_backend meshsat_mqtt if { req_ssl_sni -i mqtt.example.com }

    # Everything else goes to the default HTTPS backend
    default_backend meshsat_https

# =============================================================================
# BACKEND: Reticulum HDLC — TCP passthrough to stunnel
# =============================================================================

# stunnel terminates TLS and forwards plaintext HDLC to Hub :4242.
# Python RNS and MeshSat Bridge nodes connect here for Reticulum transport.

backend meshsat_reticulum
    mode tcp
    option tcp-check

    # CHANGE: Replace with your stunnel address (usually localhost:4243)
    server stunnel1 127.0.0.1:4243 check inter 10s fall 3 rise 2

# =============================================================================
# BACKEND: MQTT mTLS — TCP passthrough (no TLS termination)
# =============================================================================

# NATS handles TLS directly — HAProxy just forwards the raw TCP stream.
# Bridges present client certificates to NATS, not to HAProxy.

backend meshsat_mqtt
    mode tcp
    balance roundrobin
    option tcp-check

    # CHANGE: Replace with your actual node IPs
    # For a single-node setup, use one server line.
    # For multi-node, add all nodes. HAProxy health-checks port 9443.
    server node1 10.0.0.1:9443 check inter 10s fall 3 rise 2
    server node2 10.0.0.2:9443 check inter 10s fall 3 rise 2 backup

# =============================================================================
# BACKEND: Hub HTTPS — TLS termination at nginx
# =============================================================================

backend meshsat_https
    mode tcp
    balance roundrobin
    option tcp-check

    # CHANGE: Replace with your actual node IPs
    # Port 8451 is the nginx TLS listener in the Hub compose stack.
    server node1 10.0.0.1:8451 check inter 10s fall 3 rise 2
    server node2 10.0.0.2:8451 check inter 10s fall 3 rise 2 backup

# =============================================================================
# STATS (optional — access at http://localhost:8404/stats)
# =============================================================================

frontend stats
    bind *:8404
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if LOCALHOST
